From 5e0f4c1a2b3d4e5f6a7b8c9d0e1f2a3b4c5d6e7f Mon Sep 17 00:00:00 2001
From: peridot-multiboot CI <ci@peridot-multiboot.local>
Date: Thu, 1 Jan 2026 00:00:00 +0000
Subject: [PATCH 1/1] Add multiboot Kconfig fragment (KEXEC + simpledrm)

Enables:
  - CONFIG_KEXEC / CONFIG_KEXEC_FILE : early kexec handoff to other OSes
  - CONFIG_DRM_SIMPLEDRM             : pre-vendor-module display so the
    pre-init boot menu can draw on the ABL-provided framebuffer
Disables:
  - CONFIG_MODULE_SIG_PROTECT        : a rebuilt GKI kernel has its own
    module signing key; stock Xiaomi vendor modules would otherwise be
    rejected (see docs/04-kernel-analysis.md for the trade-off)

Signed-off-by: peridot-multiboot CI <ci@peridot-multiboot.local>
---
 arch/arm64/configs/vendor/multiboot.fragment | 13 +++++++++++++
 1 file changed, 13 insertions(+)
 create mode 100644 arch/arm64/configs/vendor/multiboot.fragment

diff --git a/arch/arm64/configs/vendor/multiboot.fragment b/arch/arm64/configs/vendor/multiboot.fragment
new file mode 100644
index 000000000000..111111111111
--- /dev/null
+++ b/arch/arm64/configs/vendor/multiboot.fragment
@@ -0,0 +1,13 @@
+# peridot-multiboot: Kconfig fragment merged on top of
+# gki_defconfig + vendor/peridot_GKI.config
+
+CONFIG_KEXEC=y
+CONFIG_KEXEC_FILE=y
+
+# Pre-init menu display before vendor DRM modules load
+CONFIG_DRM_SIMPLEDRM=y
+
+# Rebuilt kernel ships its own module key; keep loading permissive so
+# stock signed vendor modules still bind (orange-state device).
+# CONFIG_MODULE_SIG_PROTECT is not set
+
-- 
2.40.0

