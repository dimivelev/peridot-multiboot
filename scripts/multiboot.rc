# multiboot.rc — injected into vendor_boot vendor ramdisk
# Reads the choice written by the pre-init bootmenu (/init → /metadata/multiboot/active)
# and bind-mounts the selected ROM's images over the dynamic partitions.

on early-fs
    wait /dev/block/by-name/metadata
    mount ext4 /dev/block/by-name/metadata /metadata nosuid nodev
    read_multiboot /metadata/multiboot/active

on propertypersist.multiboot.active=rom2
    exec_background u:r:su:s0 root root -- /system/bin/multiboot-mount rom2

# NOTE: v1 uses a simpler strategy — the bootmenu writes the choice and a
# static /system/bin/multiboot-mount helper (pushed via our ROM2 image or
# Magisk module) performs losetup + mount --bind before zygote starts.
# See docs/02-multiboot-architecture.md §2.1 Scheme A.
